# ---------------------------------------------------------------------------
# Mira — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Everything here is validated at boot by src/config/env.ts; a missing or
# malformed value fails the process rather than surfacing later as a 500.
#
# Only NEXT_PUBLIC_* values reach the browser. Never put a secret behind that
# prefix.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Application ------------------------------------------------------------
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# DATABASE_URL goes through the connection pooler (PgBouncer/Neon proxy).
# DIRECT_URL bypasses it; Prisma Migrate requires a direct connection.
DATABASE_URL="postgresql://user:password@localhost:5432/mira?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/mira?schema=public"

# --- Authentication ---------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional OAuth. Leave blank to disable the Google button entirely.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Payments ---------------------------------------------------------------
# No gateway is wired up yet. The checkout UI and order lifecycle run against
# the "manual" provider, which records an unpaid order for offline settlement.
# Set to `stripe` or `razorpay` once a provider is chosen and implemented.
PAYMENT_PROVIDER=manual

# --- Media ------------------------------------------------------------------
# Optional in development; product images fall back to their stored URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Email ------------------------------------------------------------------
# Optional in development: with no key, mail is logged (including the
# verification and reset links) instead of sent, so the flows stay testable.
#
# For production you must verify a domain in Resend. Until you do, Resend only
# allows sending from onboarding@resend.dev to your own signup address, which
# means no real customer receives anything. Once verified, set EMAIL_FROM to an
# address on that domain.
RESEND_API_KEY=
EMAIL_FROM="Mira <orders@mira.example>"
EMAIL_REPLY_TO="support@mira.example"

# --- Redis (rate limiting / caching) ----------------------------------------
# Optional, and the presence of these two variables is the switch: set them and
# rate limits are enforced across the whole deployment; leave them blank and
# the limiter falls back to a per-instance in-memory store. That fallback is
# correct on a single node, but on Vercel each concurrent instance keeps its
# own counters, so an effective limit becomes (limit x instances).
#
# Provision with: vercel integration add upstash/upstash-kv
# then: vercel env pull
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Jobs & observability ---------------------------------------------------
# Bearer token required by /api/cron/*. Generate like AUTH_SECRET.
CRON_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=debug

# --- Store configuration ----------------------------------------------------
NEXT_PUBLIC_STORE_NAME=Mira
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
# Free shipping above this subtotal, in minor units (200000 = Rs 2,000.00)
FREE_SHIPPING_THRESHOLD_MINOR=200000
# Flat shipping charge below the threshold, in minor units
STANDARD_SHIPPING_FEE_MINOR=9900
# How long checkout holds stock before the reservation is released
RESERVATION_TTL_MINUTES=15
# Tax rate in basis points (500 = 5.00%)
TAX_RATE_BPS=500

# --- Seeding (development / staging only) -----------------------------------
SEED_ADMIN_EMAIL=admin@mira.example
SEED_ADMIN_PASSWORD=ChangeMe123!

# Set to 1 to print every SQL statement Prisma runs (very noisy)
PRISMA_LOG_QUERIES=
